{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemscribe.dev/schema/model-registry.schema.json",
  "title": "Stemscribe Model & Runtime Registry",
  "description": "随 app 发版的只读目录，声明可下载的运行时与模型权重。sha256 为 null 时必须同时存在 TBD 标记（待实测回填），禁止编造校验值。",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "mirrors",
    "runtimes",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mirrors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "base_url",
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtime"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "sha256OrTbd": {
      "description": "64 位小写十六进制；未实测时为 null，且同级 tbd 必须为 true",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileRef": {
      "type": "object",
      "required": [
        "url",
        "size",
        "sha256",
        "dest"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrTbd"
        },
        "tbd": {
          "type": "boolean",
          "default": false
        },
        "dest": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
          "description": "相对路径，禁止绝对路径与 .. 穿越"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            },
            "required": [
              "sha256"
            ]
          },
          "then": {
            "required": [
              "tbd"
            ],
            "properties": {
              "tbd": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "license": {
      "type": "object",
      "required": [
        "spdx"
      ],
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "id",
        "engine",
        "version",
        "backend",
        "platform",
        "archive",
        "entrypoint",
        "vram_overhead_mb",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "engine": {
          "enum": [
            "whisper",
            "separator",
            "ffmpeg"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
          "description": "Version token. Semver for whisper.cpp, but ffmpeg ships build ids like N-129046, so a strict semver pattern would reject a real, verified runtime."
        },
        "backend": {
          "enum": [
            "cuda12",
            "cuda11",
            "vulkan",
            "directml",
            "cpu",
            "none"
          ]
        },
        "platform": {
          "enum": [
            "windows-x64",
            "windows-arm64",
            "darwin-arm64",
            "linux-x64"
          ]
        },
        "archive": {
          "$ref": "#/$defs/fileRef"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cuda": {
              "type": "string",
              "maxLength": 16
            },
            "driver": {
              "type": "string",
              "maxLength": 16
            },
            "vcruntime": {
              "type": "string",
              "maxLength": 16
            }
          }
        },
        "vram_overhead_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "license": {
          "$ref": "#/$defs/license"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "engine",
        "display_name",
        "files",
        "vram_estimate_mb",
        "disk_after_install_mb",
        "quality_tier",
        "license",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "family": {
          "enum": [
            "whisper",
            "separator"
          ]
        },
        "engine": {
          "enum": [
            "whisper",
            "separator"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "langs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16
          },
          "maxItems": 32
        },
        "stems": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "vocals",
              "instrumental",
              "drums",
              "bass",
              "other"
            ]
          },
          "description": "Actual outputs of a separator model. MDX/VR = 2, Demucs = 4. Required for family=separator (ADR-019)."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileRef"
          }
        },
        "vram_estimate_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768,
          "description": "Steady-state VRAM in MB. 0 is correct for a CPU-only separator; whisper models must declare more."
        },
        "ram_estimate_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 131072
        },
        "disk_after_install_mb": {
          "type": "integer",
          "minimum": 1
        },
        "quality_tier": {
          "enum": [
            "light",
            "balanced",
            "max"
          ]
        },
        "segment_default_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "quantization": {
          "enum": [
            "f16",
            "q8_0",
            "q5_0",
            "q4_0",
            "int8",
            "fp32"
          ]
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "whisper"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "vram_estimate_mb": {
                "minimum": 64
              }
            }
          }
        }
      ]
    }
  }
}
