root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.go]
indent_style = tab
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.ps1]
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf
